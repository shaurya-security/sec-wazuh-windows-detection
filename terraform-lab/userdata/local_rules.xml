<!--
  SOC simulation rules - Wazuh manager custom ruleset.

  LOG FORMAT CONTRACT (pinned, do not deviate):
    - Transport : <log_format>eventchannel</log_format> on the agent
    - Channel   : Security (native Windows audit), NOT Sysmon
    - Fields    : win.system.*  and  win.eventdata.*

  Rules anchor on <decoded_as>windows_eventchannel</decoded_as> rather than
  <if_sid> so they survive Wazuh base-ruleset renumbering across releases.

  Every rule constrains win.system.channel explicitly. Without it, a Sysmon or
  forwarded event carrying a colliding eventID could match by accident.

  ID range: 115000-115999 (custom, outside Wazuh's reserved space).
-->
<group name="windows,soc_simulation,">

  <!-- ============================================================
       SCENARIO 1: SUSPICIOUS POWERSHELL EXECUTION (T1059.001)
       Source: Security 4688 (A new process has been created)
       Requires: auditpol "Process Creation" + ProcessCreationIncludeCmdLine
       ============================================================ -->



  <rule id="115100" level="12">
    <if_sid>92057</if_sid>

    <field name="win.eventdata.commandLine" type="pcre2">(?i)(-nop|-noprofile|-windowstyle\s+hidden|-encodedcommand|-executionpolicy\s+bypass)</field>

    <description>SOC-SIM [Scenario 1]: Suspicious PowerShell execution - $(win.eventdata.commandLine)</description>

    <mitre>
      <id>T1059.001</id>
    </mitre>

    <options>no_full_log</options>
  </rule>


  <!-- ============================================================
       SCENARIO 2: FAILED LOGON BRUTE FORCE (T1110)
       Source: Security 4625 (An account failed to log on)
       ============================================================ -->


  <!-- Base Rule: Individual Failed Logon -->
  <rule id="115200" level="13">
    <!-- 1. Intercept the log right after the native Windows failed logon rule matches it -->
    <if_sid>60122</if_sid>
    
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4625$</field>
    
    <!-- 2. Standardized description injecting the targeted username -->
    <description>SOC-SIM [Scenario 2]: Failed logon for user $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>

  <!-- Correlated Rule: Brute-Force Detection -->
  <rule id="115210" level="13" frequency="5" timeframe="60">
    <!-- 1. Correctly chain it to look at your custom base rule -->
    <if_matched_sid>115200</if_matched_sid>
    
    <!-- 2. Track failures specific to each unique user target -->
    <same_field>win.eventdata.targetUserName</same_field>
    
    <description>SOC-SIM [Scenario 2]: Brute-force - repeated failed logons for $(win.eventdata.targetUserName)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
  </rule>


  <!-- ============================================================
       SCENARIO 3: SCHEDULED TASK PERSISTENCE (T1053.005)
       Source A: Security 4688 - schtasks.exe with /create
       Source B: Security 4698 - A scheduled task was created
       Requires: auditpol "Other Object Access Events" for 4698
       ============================================================ -->



  <!-- Rule 1: Command line execution of schtasks.exe /create -->
  <rule id="115300" level="14">
    <!-- UPDATED: Pointing to your environment's real 4688 parent rule -->
    <if_sid>67027</if_sid> 
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4688$</field>
    <field name="win.eventdata.newProcessName" type="pcre2">(?i)\\schtasks\.exe$</field>
    <field name="win.eventdata.commandLine" type="pcre2">(?i)[-/]create</field>
    <description>SOC-SIM [Scenario 3]: schtasks.exe invoked to create a scheduled task</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Rule 2: Scheduled task creation audit event -->
  <rule id="115301" level="14">
    <!-- UPDATED: Pointing to your environment's real 4698 parent rule -->
    <if_sid>60228</if_sid>
    <decoded_as>windows_eventchannel</decoded_as>
    <field name="win.system.channel">^Security$</field>
    <field name="win.system.eventID">^4698$</field>
    <description>SOC-SIM [Scenario 3]: Security audit logged scheduled task creation - $(win.eventdata.taskName)</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

  <!-- Rule 3: High-Confidence Correlation Layer -->
  <rule id="115310" level="14" timeframe="60">
    <if_sid>115301</if_sid>
    <if_matched_sid>115300</if_matched_sid>
    <description>SOC-SIM [Scenario 3]: HIGH CORRELATION - scheduled task persistence created via command line</description>
    <mitre>
      <id>T1053.005</id>
    </mitre>
  </rule>

</group>
